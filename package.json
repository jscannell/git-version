{
  "name": "git-version",
  "version": "1.0.0",
  "description": "Semver versioning based on the git history and commit messages of your repository.",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --outfile=dist/index.js",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@actions/core": "^1.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
